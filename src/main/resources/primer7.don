organizeHit mul(cash a, cash b) intel cash { sendWord a * b; }

organizeHit isPositive(cash x) intel dossier {
    check (x > 0) { sendWord alive; }
    planB { sendWord whacked; }
}

organizeHit eliminate(associate target) intel dossier {
    spill($$You sure about this? y/n$$);
    dossier response;
    snitch(response);
    check (response == alive) {
        spill($$You useless stoonad$$);
        sendWord whacked;
    }
    spill($$You better leave town for a while$$);
    sendWord alive;
}

theSitDown() {
    associate earner = $$Ralph Cifaretto$$;
    cash kick_up;
    snitch(kick_up);
    cash m = mul(kick_up, 5) - 200 ;
    dossier ok = isPositive(m);
    check (ok) { spill($$We’re back in business!$$); }
    planB {
        check (eliminate(earner)) { spill($$He was a Hoah$$); }
        planB { spill($$Shoulda whacked him$$); }
    }
    sleepWithTheFishes;
}

